# Copy to .env and fill in for local development.
# See infrastructure/docker/docker-compose.yml for the matching local Postgres/Redis.

NODE_ENV=development

# apps/api
DATABASE_URL=postgresql://applypilot:applypilot@localhost:5432/applypilot_dev
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-dev-only
JWT_REFRESH_SECRET=change-me-dev-only
API_PORT=3001

# services/ai
AI_SERVICE_PORT=8000
ANTHROPIC_API_KEY=

# apps/web
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# billing (stub until Phase 7)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
