{
  "manifest_version": 3,
  "name": "ApplyFocus Apply Assistant",
  "version": "0.1.0",
  "description": "Pairs with your ApplyFocus account to save jobs and review-before-autofill on supported ATS pages.",
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*.vercel.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.lever.co/*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ]
}
