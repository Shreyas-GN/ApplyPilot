// ApplyPilot database schema.
// Source of truth for shape/intent: ../../../docs/DATABASE_SCHEMA.md — keep both in sync.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String?   @map("password_hash")
  authProvider    String    @default("password") @map("auth_provider")
  status          String    @default("active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  profile                 Profile?
  resumes                 Resume[]
  coverLetterTemplates    CoverLetterTemplate[]
  matches                 Match[]
  applications            Application[]
  extensionSessions       ExtensionSession[]
  notifications           Notification[]
  subscription            Subscription?
  consentLogs             ConsentLog[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  workExperiences         WorkExperience[]
  educationEntries        Education[]
  skills                  Skill[]
  projects                Project[]
  certifications          Certification[]
  auditLogs               AuditLog[]

  @@map("users")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique @map("token_hash")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  userAgent         String?   @map("user_agent")
  ipAddress         String?   @map("ip_address")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

model Profile {
  userId   String  @id @map("user_id") @db.Uuid
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName String? @map("full_name")
  phone    String?
  location String?

  linkedinUrl       String? @map("linkedin_url")
  githubUrl         String? @map("github_url")
  portfolioUrl      String? @map("portfolio_url")
  headline          String?
  summary           String?
  yearsOfExperience Int?    @map("years_of_experience")
  employmentStatus  String? @map("employment_status")

  // Job preferences
  preferredTitles     String[] @map("preferred_titles")
  preferredLocations  String[] @map("preferred_locations")
  workMode            String?  @map("work_mode")
  employmentTypes     String[] @map("employment_types")
  expectedSalaryMin   Int?     @map("expected_salary_min")
  expectedSalaryMax   Int?     @map("expected_salary_max")
  preferredIndustries String[] @map("preferred_industries")
  excludedCompanies   String[] @map("excluded_companies")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

model WorkExperience {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     String
  title       String
  location    String?
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  isCurrent   Boolean   @default(false) @map("is_current")
  description String?
  source      String    @default("user")
  confidence  Decimal?  @db.Decimal(4, 3)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("work_experiences")
}

model Education {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution  String
  degree       String?
  fieldOfStudy String?   @map("field_of_study")
  startDate    DateTime? @map("start_date")
  endDate      DateTime? @map("end_date")
  description  String?
  source       String    @default("user")
  confidence   Decimal?  @db.Decimal(4, 3)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("education_entries")
}

model Skill {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  category   String?
  source     String   @default("user")
  confidence Decimal? @db.Decimal(4, 3)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, name])
  @@map("skills")
}

model Project {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  url         String?
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  source      String    @default("user")
  confidence  Decimal?  @db.Decimal(4, 3)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("projects")
}

model Certification {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  issuer        String?
  issueDate     DateTime? @map("issue_date")
  expiryDate    DateTime? @map("expiry_date")
  credentialUrl String?   @map("credential_url")
  source        String    @default("user")
  confidence    Decimal?  @db.Decimal(4, 3)
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("certifications")
}

model Resume {
  id                  String  @id @default(uuid()) @db.Uuid
  userId              String  @map("user_id") @db.Uuid
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  versionLabel        String  @map("version_label")
  originalFilename    String  @map("original_filename")
  mimeType            String  @map("mime_type")
  fileSizeBytes       Int     @map("file_size_bytes")
  storageKey          String  @map("storage_key")
  checksum            String?
  isPrimary           Boolean @default(false) @map("is_primary")
  processingStatus    String  @default("uploaded") @map("processing_status")
  extractedText       String? @map("extracted_text")
  processingError     String? @map("processing_error")
  sourceApplicationId String? @unique @map("source_application_id") @db.Uuid

  sourceApplication       Application?      @relation("ResumeGeneratedFromApplication", fields: [sourceApplicationId], references: [id])
  tailoredForApplications Application[]     @relation("ApplicationTailoredResume")
  parsingJob               ResumeParsingJob? @relation
  parsedData                ResumeParsedData? @relation
  createdAt                DateTime          @default(now()) @map("created_at")

  @@index([userId])
  @@map("resumes")
}

model ResumeParsingJob {
  id          String    @id @default(uuid()) @db.Uuid
  resumeId    String    @unique @map("resume_id") @db.Uuid
  resume      Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  status      String    @default("queued")
  attempts    Int       @default(0)
  error       String?
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("resume_parsing_jobs")
}

model ResumeParsedData {
  id                String    @id @default(uuid()) @db.Uuid
  resumeId          String    @unique @map("resume_id") @db.Uuid
  resume            Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  structuredData    Json      @map("structured_data")
  overallConfidence Decimal?  @map("overall_confidence") @db.Decimal(4, 3)
  reviewStatus      String    @default("pending_review") @map("review_status")
  confirmedAt       DateTime? @map("confirmed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("resume_parsed_data")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  metadata  Json?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("audit_logs")
}

model CoverLetterTemplate {
  id      String @id @default(uuid()) @db.Uuid
  userId  String @map("user_id") @db.Uuid
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tone    String
  content String

  @@map("cover_letter_templates")
}

model Job {
  id              String    @id @default(uuid()) @db.Uuid
  source          String
  externalId      String    @map("external_id")
  atsType         String?   @map("ats_type")
  title           String
  company         String
  location        String?
  descriptionRaw  String?   @map("description_raw")
  applyUrl        String?   @map("apply_url")
  postedAt        DateTime? @map("posted_at")
  ingestedAt      DateTime  @default(now()) @map("ingested_at")
  rawJson         Json?     @map("raw_json")

  embedding    JobEmbedding?
  matches      Match[]
  applications Application[]

  @@unique([source, externalId])
  @@map("jobs")
}

model JobEmbedding {
  jobId        String @id @map("job_id") @db.Uuid
  job          Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  // pgvector column — not type-safe through the generated client; query/write via
  // $queryRaw / $executeRaw. See docs/AI_AGENTS.md §2 (Job Matching Agent).
  embedding    Unsupported("vector(1536)")
  modelVersion String @map("model_version")

  @@map("job_embeddings")
}

model Match {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String   @map("job_id") @db.Uuid
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  score     Decimal
  rationale String?
  status    String   @default("new")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, jobId])
  @@index([userId, status, score])
  @@map("matches")
}

model Application {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId                String    @map("job_id") @db.Uuid
  job                  Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  mode                 String
  atsTier              String    @map("ats_tier")
  status                String   @default("queued")
  tailoredResumeId     String?   @unique @map("tailored_resume_id") @db.Uuid
  tailoredResume       Resume?   @relation("ApplicationTailoredResume", fields: [tailoredResumeId], references: [id])
  tailoredCoverLetter  String?   @map("tailored_cover_letter")
  confidenceScore      Decimal?  @map("confidence_score")
  submittedAt          DateTime? @map("submitted_at")
  failureReason        String?   @map("failure_reason")
  createdAt            DateTime  @default(now()) @map("created_at")

  generatedResume Resume?           @relation("ResumeGeneratedFromApplication")
  events          ApplicationEvent[]

  @@index([userId, status])
  @@map("applications")
}

model ApplicationEvent {
  id            String      @id @default(uuid()) @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  eventType     String      @map("event_type")
  payload       Json?
  actor         String
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([applicationId, createdAt])
  @@map("application_events")
}

model AtsConnector {
  name      String   @id
  tier      String
  config    Json?
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ats_connectors")
}

model ExtensionSession {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceLabel String?   @map("device_label")
  tokenHash   String    @map("token_hash")
  scopes      String[]
  lastSeenAt  DateTime? @map("last_seen_at")
  status      String    @default("active")

  @@map("extension_sessions")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  payload   Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@map("notifications")
}

model Subscription {
  userId                    String    @id @map("user_id") @db.Uuid
  user                      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                      String    @default("free")
  status                    String    @default("active")
  billingProviderCustomerId String?   @map("billing_provider_customer_id")
  currentPeriodEnd          DateTime? @map("current_period_end")

  @@map("subscriptions")
}

model ConsentLog {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentType String    @map("consent_type")
  grantedAt   DateTime  @default(now()) @map("granted_at")
  revokedAt   DateTime? @map("revoked_at")

  @@map("consent_logs")
}
