{
  "manifest_version": 3,
  "name": "ApplyPilot Apply Assistant",
  "version": "0.0.0",
  "description": "Pairs with your ApplyPilot account to autofill and review job applications in your own browser session.",
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [],
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ]
}
