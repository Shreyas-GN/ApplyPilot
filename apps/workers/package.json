{
  "name": "@applypilot/workers",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@applypilot/shared": "workspace:*",
    "@applypilot/validators": "workspace:*",
    "bullmq": "6.5.3",
    "ioredis": "6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.20.5",
    "eslint": "9.17.0",
    "ts-node-dev": "2.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
