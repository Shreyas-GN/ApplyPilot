{
  "name": "@applypilot/workers",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\"",
    "prisma:generate": "prisma generate --schema=../api/prisma/schema.prisma"
  },
  "dependencies": {
    "@applypilot/shared": "workspace:*",
    "@applypilot/validators": "workspace:*",
    "@aws-sdk/client-s3": "3.1161.0",
    "@prisma/client": "6.19.3",
    "bullmq": "6.5.3",
    "dotenv": "^16.4.7",
    "ioredis": "6.0.0",
    "mammoth": "1.13.0",
    "pdf-parse": "2.4.5"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.20.5",
    "eslint": "9.17.0",
    "prisma": "6.19.3",
    "ts-node-dev": "2.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
