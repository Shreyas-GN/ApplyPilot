# Copy to .env and fill in for local development.
# See docker-compose.yml for the matching local Postgres/Redis.

NODE_ENV=development

# apps/api + apps/workers (shared Node env — see packages/validators/src/env.ts)
DATABASE_URL=postgresql://applypilot:applypilot@localhost:5432/applypilot_dev
REDIS_URL=redis://localhost:6379
API_PORT=3001

# Auth. Generate real secrets with `openssl rand -base64 32` for anything
# beyond local dev — these are never allowed to be empty or short.
JWT_ACCESS_SECRET=change-me-dev-only-change-me-dev-only
JWT_REFRESH_SECRET=change-me-dev-only-change-me-dev-only
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
APP_URL=http://localhost:3000

# Email provider for verification/password-reset links.
# EMAIL_PROVIDER=console (default): no credentials needed — emails are
#   written to the API's logs instead of sent, which is the local dev and
#   test default. EMAIL_PROVIDER=smtp sends real email via any SMTP
#   provider (Mailtrap, SES SMTP, Postmark, your own server, ...).
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="ApplyPilot <no-reply@applypilot.example>"

# Object storage for resumes.
# STORAGE_PROVIDER=local (default): stores files on local disk under
#   LOCAL_STORAGE_DIR — no credentials needed, used for local dev and tests.
# STORAGE_PROVIDER=s3: any S3-compatible endpoint (AWS S3, MinIO, R2, ...).
STORAGE_PROVIDER=local
# Relative to each app's own directory (apps/api, apps/workers) — both are
# two levels under the repo root, so this resolves to the same place from
# either. Use an absolute path if you run things differently.
LOCAL_STORAGE_DIR=../../.local-storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# services/ai
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000
# Optional. Unset -> services/ai falls back to its deterministic mock parser
# (no external calls, used by default in dev/test). Set this to use Claude
# for real resume parsing.
ANTHROPIC_API_KEY=

# apps/web
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# billing (stub until Phase 7)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
